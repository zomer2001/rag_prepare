APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
STREAMLIT_PORT=8501
DATA_DIR=./data

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_IMAGE=qdrant/qdrant:v1.18.2

NEO4J_ENABLED=true
NEO4J_REQUIRED=true
NEO4J_IMAGE=neo4j:5.26-community
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rag-graph-demo-change-me
NEO4J_DATABASE=neo4j

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_EXTRACTION_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=false
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=4
AGENTIC_MAX_RETRIEVAL_ROUNDS=2
AGENTIC_RRF_K=60

EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_CONCURRENCY=2
# local: use SentenceTransformers on MPS/CUDA/CPU; bailian: use Alibaba Bailian API
EMBEDDING_PROVIDER=local
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_EMBEDDING_DIMENSIONS_ENABLED=true
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_EMBEDDING_DIMENSIONS_ENABLED=true
EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=3

RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto

PARSER_OCR_ENABLED=false
MAX_UPLOAD_SIZE_MB=50
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

LIGHTRAG_WORKING_DIR=./data/lightrag
LIGHTRAG_WORKSPACE=demo_v1
LIGHTRAG_QUERY_MODE=mix
LIGHTRAG_TOP_K=20
LIGHTRAG_CHUNK_TOP_K=10
LIGHTRAG_MAX_TOTAL_TOKENS=24000
LIGHTRAG_COSINE_THRESHOLD=0.2
LIGHTRAG_SUMMARY_LANGUAGE=Chinese
ENTITY_EXTRACTION_USE_JSON=true
LIGHT_ENTITY_PROMPT_FILE=./prompts/entity_type/light_entity.yaml
LIGHT_ENTITY_MAX_GLEANING=0
LIGHT_ENTITY_MAX_ENTITIES=4
LIGHT_ENTITY_MAX_RELATIONSHIPS=4
LIGHT_ENTITY_MAX_RECORDS=8
GRAPH_INDEX_CONCURRENCY=2
EVENT_EXTRACTION_ENABLED=true
EVENT_EXTRACTION_CHUNK_CHARS=12000
EVENT_EXTRACTION_MAX_EVENTS=12
EVENT_EXTRACTION_MAX_EVENTS_PER_PART=5
EVENT_INDEX_CONCURRENCY=3
TKG_ENABLED=true
TKG_ONTOLOGY_VERSION=0.1.0
TKG_ONTOLOGY_DIR=./ontology
# Empty means DATA_DIR/tkg/tkg_store.json
TKG_REGISTRY_PATH=
TKG_VALIDATE_SHACL=true
ENTITY_TYPE_MAPPING_FILE=./ontology/mappings/entity_types.json
ENTITY_RESOLUTION_ENABLED=true
ENTITY_RESOLUTION_CANDIDATE_LIMIT=5
ENTITY_RESOLUTION_EMBEDDING_THRESHOLD=0.72
ENTITY_RESOLUTION_AUTO_MATCH_THRESHOLD=0.94
ENTITY_RESOLUTION_LLM_THRESHOLD=0.78

RAG_API_BASE_URL=http://127.0.0.1:8000/api/v1
